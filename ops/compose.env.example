# Local Compose fixture placeholders. Not production secrets.
# Copy values into the shell or a gitignored env file before `docker compose up`.
# TTL / retrieval k values below are fixtures, not frozen TBD-P0.
# CI must not start Compose.
# app profile: docker compose --profile app up  (api + web + worker)
# Worker queue names and concurrency are fixtures, not frozen TBD-P0.

POSTGRES_USER=pivot
POSTGRES_PASSWORD=pivot_dev_only
POSTGRES_DB=pivot

MINIO_ROOT_USER=pivotminio
MINIO_ROOT_PASSWORD=pivot_dev_only

PIVOT_TOKEN_SECRET=pivot_dev_only_change_me
PIVOT_ACCESS_TTL=900
PIVOT_REFRESH_TTL=86400
PIVOT_EXPORT_TTL=3600
PIVOT_DOWNLOAD_TTL=300
PIVOT_EXPORT_PUBLIC_BASE=http://127.0.0.1:8000/files
PIVOT_RETRIEVAL_K=8
# App profile api+worker share PG facts and MinIO bytes. Fixture, not frozen TBD-P0.
PIVOT_STORAGE=postgres
PIVOT_OBJECT_STORE=minio
PIVOT_VECTOR_STORE=memory
PIVOT_CACHE_STORE=memory
PIVOT_QUEUE_STORE=memory
# Optional Qdrant for worker IndexPublisher. Required when PIVOT_VECTOR_STORE=qdrant.
# Fixture hostnames, not production URLs, not frozen TBD-P0. Dimension/distance stay injected.
# PIVOT_QDRANT_ENDPOINT=
# PIVOT_QDRANT_COLLECTION=
# PIVOT_QDRANT_VECTOR_SIZE=
# PIVOT_QDRANT_DISTANCE=
# PIVOT_QDRANT_ENSURE_COLLECTION=
# Next rewrite target. Local next dev uses the published api port.
# docker compose --profile app should inject the api service hostname
# (for example http://api:8000). Not a production URL; not frozen TBD-P0.
PIVOT_API_ORIGIN=http://127.0.0.1:8000
# Parse/online queues must stay isolated. Values are fixtures, not frozen TBD-P0.
PIVOT_PARSE_QUEUE=parse
PIVOT_ONLINE_QUEUE=online
PIVOT_WORKER_CONCURRENCY=1
# Celery broker for the worker process. Fixture hostname, not a production URL, not TBD-P0.
PIVOT_CELERY_BROKER=redis://redis:6379/0
# Worker ingest requires shared PG facts and MinIO bytes. Memory cannot cross processes.
# Fixture hostnames, not production URLs, not frozen TBD-P0.
PIVOT_DATABASE_URL=postgresql+psycopg://pivot:pivot_dev_only@postgres:5432/pivot
PIVOT_MINIO_ENDPOINT=minio:9000
PIVOT_MINIO_BUCKET=pivot-docs
PIVOT_MINIO_ACCESS_KEY=pivotminio
PIVOT_MINIO_SECRET_KEY=pivot_dev_only
# Optional login rate limit. Both or neither. Requires PIVOT_CACHE_STORE=redis.
# Values are fixtures, not frozen TBD-P0.
# PIVOT_LOGIN_MAX_FAILURES=
# PIVOT_LOGIN_WINDOW_SECONDS=
# Optional HTTP Embedding / bge rerank. Values are injected, not frozen TBD-P0.
# Do not commit provider URLs or API keys.
# PIVOT_EMBEDDING=hash
# PIVOT_EMBEDDING_ENDPOINT=
# PIVOT_EMBEDDING_MODEL=
# PIVOT_EMBEDDING_API_KEY=
# PIVOT_EMBEDDING_TIMEOUT=
# PIVOT_RERANK=none
# PIVOT_RERANK_ENDPOINT=
# PIVOT_RERANK_MODEL=
# PIVOT_RERANK_API_KEY=
# PIVOT_RERANK_TIMEOUT=
