# Local Compose fixture placeholders. Not production secrets.
# Copy values into the shell or a gitignored env file before `docker compose up`.
# TTL / retrieval k values below are fixtures, not frozen TBD-P0.
# CI must not start Compose.
# app profile: docker compose --profile app up  (api + web + worker)
# Worker queue names and concurrency are fixtures, not frozen TBD-P0.

POSTGRES_USER=pivot
POSTGRES_PASSWORD=pivot_dev_only
POSTGRES_DB=pivot

MINIO_ROOT_USER=pivotminio
MINIO_ROOT_PASSWORD=pivot_dev_only

PIVOT_TOKEN_SECRET=pivot_dev_only_change_me
PIVOT_ACCESS_TTL=900
PIVOT_REFRESH_TTL=86400
PIVOT_EXPORT_TTL=3600
PIVOT_DOWNLOAD_TTL=300
PIVOT_EXPORT_PUBLIC_BASE=http://127.0.0.1:8000/files
PIVOT_RETRIEVAL_K=8
# App profile api+worker share PG facts, MinIO bytes, Qdrant vectors and Redis cache/queue.
# Fixture, not frozen TBD-P0. Redis 不是业务事实源.
PIVOT_STORAGE=postgres
PIVOT_OBJECT_STORE=minio
PIVOT_VECTOR_STORE=qdrant
PIVOT_CACHE_STORE=redis
PIVOT_QUEUE_STORE=redis
# Qdrant for api retrieval and worker IndexPublisher. Required when PIVOT_VECTOR_STORE=qdrant.
# Fixture hostnames, not production URLs, not frozen TBD-P0. Dimension/distance stay injected.
PIVOT_QDRANT_ENDPOINT=qdrant:6333
PIVOT_QDRANT_COLLECTION=pivot
PIVOT_QDRANT_VECTOR_SIZE=4
# PIVOT_QDRANT_DISTANCE=
# PIVOT_QDRANT_ENSURE_COLLECTION=
# Redis cache/queue endpoint. Required when PIVOT_CACHE_STORE or PIVOT_QUEUE_STORE is redis.
# Fixture hostname, not a production URL, not frozen TBD-P0. Redis 不是业务事实源.
PIVOT_REDIS_ENDPOINT=redis:6379
# Next rewrite target. Local next dev uses the published api port.
# docker compose --profile app should inject the api service hostname
# (for example http://api:8000). Not a production URL; not frozen TBD-P0.
PIVOT_API_ORIGIN=http://127.0.0.1:8000
# App profile HTTP enqueue. Fixture, not frozen TBD-P0.
# Process-out assemble_runtime still defaults to sync when this is unset.
PIVOT_INGEST=celery
# Parse/online queues must stay isolated. Values are fixtures, not frozen TBD-P0.
PIVOT_PARSE_QUEUE=parse
PIVOT_ONLINE_QUEUE=online
PIVOT_WORKER_CONCURRENCY=1
# Celery broker for api enqueue and the worker process. Fixture hostname, not a production URL, not TBD-P0.
# Do not set PIVOT_CELERY_EAGER=1 in Compose; eager is CI-only.
PIVOT_CELERY_BROKER=redis://redis:6379/0
# Worker ingest requires shared PG facts and MinIO bytes. Memory cannot cross processes.
# Fixture hostnames, not production URLs, not frozen TBD-P0.
PIVOT_DATABASE_URL=postgresql+psycopg://pivot:pivot_dev_only@postgres:5432/pivot
PIVOT_MINIO_ENDPOINT=minio:9000
PIVOT_MINIO_BUCKET=pivot-docs
PIVOT_MINIO_ACCESS_KEY=pivotminio
PIVOT_MINIO_SECRET_KEY=pivot_dev_only
# App profile login lockout via Redis CacheStore. Both required together.
# Fixture values, not frozen TBD-P0. Process-out assemble_runtime still never locks when both omitted.
PIVOT_LOGIN_MAX_FAILURES=5
PIVOT_LOGIN_WINDOW_SECONDS=900
# App profile api+worker share HTTP Embedding when PIVOT_EMBEDDING=http.
# Fixture hash keeps Compose without live keys. Staging may inject endpoint/model/key.
# Do not commit provider URLs or API keys. Values are injected, not frozen TBD-P0.
PIVOT_EMBEDDING=hash
# PIVOT_EMBEDDING_ENDPOINT=
# PIVOT_EMBEDDING_MODEL=
# PIVOT_EMBEDDING_API_KEY=
# PIVOT_EMBEDDING_TIMEOUT=
# PIVOT_RERANK=none
# PIVOT_RERANK_ENDPOINT=
# PIVOT_RERANK_MODEL=
# PIVOT_RERANK_API_KEY=
# PIVOT_RERANK_TIMEOUT=
# App profile api Draft Writer when PIVOT_LLM=http. Worker does not call Writer.
# Fixture local keeps Compose without live keys. Staging may inject official chat.
# Do not commit provider URLs or API keys. Values are injected, not frozen TBD-P0.
PIVOT_LLM=local
# PIVOT_LLM_ENDPOINT=
# PIVOT_LLM_MODEL=
# PIVOT_LLM_API_KEY=
# PIVOT_LLM_TIMEOUT=
# PIVOT_LLM_AUTH_HEADER=
# PIVOT_LLM_AUTH_SCHEME=
# PIVOT_LLM_FALLBACK_ENDPOINT=
# PIVOT_LLM_FALLBACK_MODEL=
# PIVOT_LLM_FALLBACK_API_KEY=
# PIVOT_LLM_FALLBACK_TIMEOUT=
# PIVOT_LLM_FALLBACK_AUTH_HEADER=
# PIVOT_LLM_FALLBACK_AUTH_SCHEME=
